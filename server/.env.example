# Copy to .env and fill in the providers you actually use.

# --- Pipeline stage selection -------------------------------------------------
# Which provider runs at each stage. Default is "none" (a no-op that stores the
# audio but produces an empty transcript) so the server runs with zero keys.
# Flip these to the cloud providers once you've set the matching key below.
# OP_PIPELINE__TRANSCRIPTION=openai_whisper   # default: none; or whisper_cpp
# OP_PIPELINE__SUMMARIZATION=claude           # default: none; or ollama
# OP_PIPELINE__DIARIZATION=none               # opt-in; or pyannote / whisperx

# Optional model overrides (sensible defaults shown):
# OP_WHISPER_MODEL=whisper-1
# OP_CLAUDE_MODEL=claude-haiku-4-5            # cheapest tier; use claude-sonnet-4-6
#                                            # or claude-opus-4-8 for higher quality

# --- Local transcription (whisper.cpp) -----------------------------------------
# OP_PIPELINE__TRANSCRIPTION=whisper_cpp selects fully local transcription: no
# cloud key, just whisper.cpp installed on the host (e.g. `brew install whisper-cpp`).
# OP_WHISPER_CPP_BIN=whisper-cli              # default: `whisper-cli` on PATH
# OP_WHISPER_CPP_MODEL=models/ggml-base.en.bin  # required: ggml/gguf model file from
#                                            # huggingface.co/ggerganov/whisper.cpp
# OP_WHISPER_CPP_TIMEOUT_SECONDS=900
# OP_WHISPER_CPP_ARGS=

# --- Local summarization (Ollama) ----------------------------------------------
# OP_OLLAMA_URL=http://127.0.0.1:11434
# OP_OLLAMA_MODEL=qwen2.5:7b

# --- Speaker diarization -------------------------------------------------------
# HUGGINGFACE_TOKEN=                          # used by pyannote/whisperx if needed
# OP_PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
# OP_WHISPERX_BIN=whisperx
# OP_WHISPERX_MODEL=base
# OP_WHISPERX_TIMEOUT_SECONDS=1800

# Where audio blobs + the SQLite DB live (default: ./storage):
# OP_STORAGE_DIR=storage

# Upload protection. 512 MiB fits roughly multi-hour 16 kHz stereo WAV captures.
# OP_UPLOAD_MAX_BYTES=536870912

# --- Hooker vibecoding dispatch ----------------------------------------------
# Optional: publish completed transcripts into a Hooker topic for agent execution.
# Hooker then owns topic history, routing, and the agent bridge to OpenCode/Pi.
# OP_HOOKER__ENABLED=false
# OP_HOOKER__URL=https://hooker.example.com
# OP_HOOKER__API_KEY=hk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OP_HOOKER__TOPIC=agent_in
# OP_HOOKER__PRIORITY=3
# OP_HOOKER__TAGS=agent,user,voice,open-plaud
# OP_HOOKER__TIMEOUT_SECONDS=15
# OP_HOOKER__PROMPT_FOOTER=Treat this as a spoken vibecoding command. If the request is ambiguous or could mutate files in a risky way, ask for clarification or propose a plan before changing code.

# --- Secrets ------------------------------------------------------------------
# Transcription (cloud-first)
OPENAI_API_KEY=          # OpenAI Whisper API (transcription)
# DEEPGRAM_API_KEY=
# GROQ_API_KEY=

# Summarization
ANTHROPIC_API_KEY=       # Claude summarization
# GEMINI_API_KEY=
