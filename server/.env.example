# Copy to .env and fill in the providers you actually use.

# --- Pipeline stage selection -------------------------------------------------
# Which provider runs at each stage. Default is "none" (a no-op that stores the
# audio but produces an empty transcript) so the server runs with zero keys.
# Flip these to the cloud providers once you've set the matching key below.
# OP_PIPELINE__TRANSCRIPTION=openai_whisper   # default: none
# OP_PIPELINE__SUMMARIZATION=claude           # default: none
# OP_PIPELINE__DIARIZATION=none               # opt-in; off by default

# Optional model overrides (sensible defaults shown):
# OP_WHISPER_MODEL=whisper-1
# OP_CLAUDE_MODEL=claude-haiku-4-5            # cheapest tier; use claude-sonnet-4-6
#                                            # or claude-opus-4-8 for higher quality

# --- Local transcription (whisper.cpp) -----------------------------------------
# OP_PIPELINE__TRANSCRIPTION=whisper_cpp selects fully local transcription: no
# cloud key, just whisper.cpp installed on the host (e.g. `brew install whisper-cpp`).
# OP_WHISPER_CPP_BIN=whisper-cli              # default: `whisper-cli` on PATH
# OP_WHISPER_CPP_MODEL=models/ggml-base.en.bin  # required: ggml/gguf model file from
#                                            # huggingface.co/ggerganov/whisper.cpp

# Where audio blobs + the SQLite DB live (default: ./storage):
# OP_STORAGE_DIR=storage

# --- Secrets ------------------------------------------------------------------
# Transcription (cloud-first)
OPENAI_API_KEY=          # OpenAI Whisper API (transcription)
# DEEPGRAM_API_KEY=
# GROQ_API_KEY=

# Summarization
ANTHROPIC_API_KEY=       # Claude summarization
# GEMINI_API_KEY=
